# Operator settings. End users do not configure these.
LITECOM_HOST=litecom.example.com
ACME_EMAIL=you@example.com

# Required for phone sign-in and SMS approval notices.
# Get these from Twilio Console; attach an approved sender to the Messaging Service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Optional email approval notices and replies. SMTP_FROM is the full verified sender address.
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REPLY_TO=
# A dedicated receiving mailbox for the SMTP_FROM or SMTP_REPLY_TO address.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Optional Slack approval notices. Configure the callback described in docs/approval-channels.md.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
