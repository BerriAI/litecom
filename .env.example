# Operator settings. End users do not configure these.
LITECOM_HOST=litecom.example.com
ACME_EMAIL=you@example.com

# Google sign-in. Use a Web application OAuth client with this redirect:
# https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Workspace domains. Empty permits any verified Google account.
GOOGLE_ALLOWED_DOMAINS=

# Optional phone approvals and incoming replies.
# Configure the AgentPhone sender and webhook once: docs/approval-channels.md
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
AGENTPHONE_WEBHOOK_SECRET=

# Optional email approval notices and replies. SMTP_FROM is the full verified sender address.
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REPLY_TO=
# A dedicated receiving mailbox for the SMTP_FROM or SMTP_REPLY_TO address.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Optional Slack approval notices. Configure the callback described in docs/approval-channels.md.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
